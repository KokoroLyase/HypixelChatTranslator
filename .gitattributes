# 行尾与文本/二进制判定，见 https://git-scm.com/docs/gitattributes
#
# 默认按文本处理并统一成 LF：这样即使在 Windows 上 clone 也不会变成 CRLF，
# 避免「只改了行尾」的假 diff 污染历史。
* text=auto eol=lf

# 二进制文件绝不参与行尾转换 —— gradle-wrapper.jar 一旦被转换过就跑不起来了
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ogg binary

# Linux start script should use lf（两条线各有一份 wrapper，都要钉；
# 只写 /gradlew 是根目录专属路径，嵌套的那份会落到全局的 text=auto 上）
gradlew         text eol=lf
forge-1.8.9/gradlew text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf
