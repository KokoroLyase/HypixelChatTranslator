# gradle

.gradle/
build/
out/
classes/

# 本机构建用的临时目录（便携 JDK / Gradle 缓存 / TMPDIR），绝不入库
/.jdk/
/.gradle-home/
/.tmp/
**/.tmp/
# 构建与反向验证时重定向出来的日志（曾经误提交过一次 .build-263.txt）
/.build-*.txt
/.reverse-*.txt
/.probe*.txt

# 本地配置（含 DeepSeek API Key），绝对不要提交
config/server_chat_translator.json
run/config/server_chat_translator.json
# `**/` 前缀是防御性的第二道线：没有它，中间带斜杠的模式只相对仓库根解析，
# 嵌套目录（例如 forge-1.8.9/config/…）里的同名文件不会被忽略。
**/config/server_chat_translator.json
# v3.0.0 更名前的老配置文件名也要继续忽略：它同样含明文 API Key，
# 而玩家机器上那个文件还在（本轮不做搬迁）。这一行是第二道防线 ——
# 万一谁把老文件复制进仓库，也不会把 Key 一起提上去。
config/hxtranslate.json
run/config/hxtranslate.json
**/config/hxtranslate.json
config/*.json.broken-*
*.local.json

# eclipse

*.launch

# idea

.idea/
*.iml
*.ipr
*.iws

# vscode

.settings/
.vscode/
bin/
.classpath
.project

# macos / windows 系统垃圾文件
# Thumbs.db 与 Desktop.ini 是 Windows 侧的同类东西；本仓库主开发平台是 Windows，
# 而 .editorconfig / .gitattributes 都为 *.bat 单列了 CRLF，说明两边都在用 —— 对称补上。
# （v3.0.8 洁净度审计；当时仓库里还没有这两个文件，属于预防）

*.DS_Store
Thumbs.db
Desktop.ini

# 会话工具的项目数据目录（记忆、技能稿等本地笔记）
# RELEASING §3 的发布流程写的是 `git add -A && git commit`，不加这一行就会把
# 52 KB 的本机笔记一起提交上去（v3.0.8 洁净度审计发现它一直是未跟踪状态）。
# 注意：这是**忽略**，不是删除 —— 目录本身要保留。
/.workbuddy/

# fabric

run/

# 运行期产物：跑离线自检（./gradlew verifyCore）时 slf4j 会在项目根目录写出 logs/
logs/
crash-reports/

# 会话衔接提示词（本地草稿，不入库）

*衔接提示词*.txt

# java

hs_err_*.log
replay_*.log
*.hprof
*.jfr
